<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Smart Waste Collection & AI Incident Resolution</title>

  <!-- MapLibre GL JS (Vector WebGL as used by Traccar) -->
  <link href="https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.css" rel="stylesheet" />
  <script src="https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.js"></script>

  <!-- Fonts & Icons -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body, html {
      width: 100%; height: 100%; overflow: hidden;
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
      background: #0f172a; color: #1e293b;
    }
    #map { position: absolute; top: 0; bottom: 0; width: 100%; height: 100%; }

    /* Top Floating Control Bar */
    .control-panel {
      position: absolute;
      top: 14px; left: 16px; right: 16px;
      z-index: 10;
      background: rgba(255, 255, 255, 0.95);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid rgba(226, 232, 240, 0.9);
      border-radius: 12px;
      padding: 10px 16px;
      box-shadow: 0 10px 30px rgba(15, 23, 42, 0.12);
      display: flex;
      align-items: center;
      gap: 12px;
      flex-wrap: wrap;
    }

    .brand {
      display: flex; align-items: center; gap: 8px;
      font-weight: 800; font-size: 15px; color: #0f172a;
      letter-spacing: -0.3px; margin-right: 4px;
    }
    .brand i { color: #10b981; font-size: 18px; }

    /* Mode Buttons (Add bin, depot, incident) */
    .mode-group {
      display: flex; background: #f1f5f9; border-radius: 8px; padding: 3px; gap: 2px;
    }
    .btn-mode {
      border: none; background: transparent; padding: 6px 12px;
      border-radius: 6px; font-size: 12.5px; font-weight: 600; color: #475569;
      cursor: pointer; display: flex; align-items: center; gap: 6px; transition: all 0.18s;
    }
    .btn-mode:hover { color: #0f172a; }
    .btn-mode.active {
      background: #ffffff; color: #0f172a;
      box-shadow: 0 2px 6px rgba(0,0,0,0.08);
    }
    .btn-mode.active-bin { color: #059669; }
    .btn-mode.active-depot { color: #dc2626; }
    .btn-mode.active-incident { color: #d97706; }

    /* Action Buttons */
    .btn-action {
      border: none; border-radius: 8px; padding: 7px 14px;
      font-size: 13px; font-weight: 600; cursor: pointer;
      display: flex; align-items: center; gap: 6px;
      transition: all 0.2s; white-space: nowrap;
    }
    .btn-primary {
      background: linear-gradient(135deg, #10b981 0%, #059669 100%);
      color: #ffffff; box-shadow: 0 4px 12px rgba(16, 185, 129, 0.3);
    }
    .btn-primary:hover {
      background: linear-gradient(135deg, #059669 0%, #047857 100%);
      transform: translateY(-1px);
    }
    .btn-secondary {
      background: #f1f5f9; color: #334155; border: 1px solid #cbd5e1;
    }
    .btn-secondary:hover { background: #e2e8f0; }

    .btn-sim {
      background: #3b82f6; color: #ffffff; box-shadow: 0 4px 12px rgba(59, 130, 246, 0.3);
    }
    .btn-sim:hover { background: #2563eb; }
    .btn-sim.simulating { background: #f59e0b; }

    /* Live Stats */
    .stats-bar {
      margin-left: auto; display: flex; align-items: center; gap: 14px;
      font-size: 12.5px; font-weight: 600; color: #334155;
    }
    .stat-badge {
      display: flex; align-items: center; gap: 5px; background: #f8fafc;
      padding: 5px 10px; border-radius: 6px; border: 1px solid #e2e8f0;
    }
    .stat-badge i { color: #10b981; }

    /* Log Drawer / Panel */
    .btn-drawer-toggle {
      border: 1px solid #cbd5e1; background: #ffffff; border-radius: 8px;
      padding: 6px 12px; font-size: 12.5px; font-weight: 600; color: #334155;
      cursor: pointer; display: flex; align-items: center; gap: 6px;
    }
    .drawer {
      position: absolute; top: 76px; right: 16px; width: 380px; max-height: calc(100vh - 120px);
      z-index: 9; background: rgba(255, 255, 255, 0.96); backdrop-filter: blur(14px);
      border: 1px solid rgba(226, 232, 240, 0.9); border-radius: 12px;
      box-shadow: 0 12px 32px rgba(15, 23, 42, 0.15); display: flex; flex-direction: column;
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .drawer.closed { transform: translateX(410px); opacity: 0; pointer-events: none; }
    .drawer-header {
      padding: 12px 16px; border-bottom: 1px solid #e2e8f0;
      font-weight: 700; font-size: 13.5px; display: flex; align-items: center;
      justify-content: space-between;
    }
    .drawer-body { padding: 12px 16px; overflow-y: auto; flex: 1; display: flex; flex-direction: column; gap: 10px; }

    /* Timeline Items */
    .timeline-item {
      display: flex; gap: 10px; font-size: 12px; line-height: 1.4;
      padding: 8px 10px; border-radius: 8px; background: #f8fafc; border-left: 3px solid #cbd5e1;
    }
    .timeline-ai { border-left-color: #3b82f6; background: #eff6ff; color: #1e40af; }
    .timeline-incident { border-left-color: #f59e0b; background: #fefce8; color: #854d0e; }
    .timeline-human { border-left-color: #ec4899; background: #fdf2f8; color: #9d174d; }
    .timeline-collected { border-left-color: #10b981; background: #ecfdf5; color: #065f46; }

    /* Truck Status Card in Drawer */
    .truck-card {
      background: #ffffff; border: 1px solid #e2e8f0; border-radius: 8px; padding: 10px;
    }
    .truck-card-header { display: flex; justify-content: space-between; font-size: 12.5px; font-weight: 700; margin-bottom: 6px; }
    .progress-bar { width: 100%; height: 7px; background: #e2e8f0; border-radius: 4px; overflow: hidden; }
    .progress-fill { height: 100%; background: #10b981; transition: width 0.3s; }

    /* Style Switcher (Traccar map options) */
    .style-picker {
      position: absolute; bottom: 24px; left: 20px; z-index: 10;
      background: rgba(255, 255, 255, 0.94); backdrop-filter: blur(12px);
      border: 1px solid rgba(226, 232, 240, 0.8); border-radius: 10px;
      padding: 4px; display: flex; gap: 4px; box-shadow: 0 8px 24px rgba(15, 23, 42, 0.12);
    }
    .style-btn {
      border: none; background: transparent; padding: 6px 12px; border-radius: 6px;
      font-size: 12px; font-weight: 600; color: #64748b; cursor: pointer;
      display: flex; align-items: center; gap: 6px; transition: all 0.2s;
    }
    .style-btn:hover { background: #f1f5f9; color: #0f172a; }
    .style-btn.active { background: #10b981; color: #ffffff; box-shadow: 0 2px 8px rgba(16, 185, 129, 0.3); }

    /* Markers - Clean wrappers for MapLibre positioning (NO transitions or animations on wrapper!) */
    .marker-depot-wrap,
    .marker-bin-wrap,
    .marker-incident-wrap,
    .marker-truck-wrap,
    .stop-badge-wrap {
      cursor: pointer;
      user-select: none;
      transition: none !important;
      animation: none !important;
    }

    .marker-depot-inner {
      width: 38px; height: 38px; background: #dc2626; border: 3px solid #ffffff;
      border-radius: 50%; box-shadow: 0 4px 12px rgba(220, 38, 38, 0.4);
      display: flex; align-items: center; justify-content: center; color: #ffffff;
      font-size: 16px; position: relative;
    }
    .marker-depot-inner::after {
      content: ''; position: absolute; width: 100%; height: 100%; border-radius: 50%;
      border: 2px solid #dc2626; animation: pulse-ring 2s infinite ease-out;
    }
    @keyframes pulse-ring { 0% { transform: scale(1); opacity: 0.8; } 100% { transform: scale(1.8); opacity: 0; } }

    .marker-bin-inner {
      width: 32px; height: 32px; border-radius: 50%; border: 2.5px solid #ffffff;
      box-shadow: 0 3px 8px rgba(0,0,0,0.25); display: flex; align-items: center;
      justify-content: center; color: #ffffff; font-size: 12px; font-weight: 700;
      transition: transform 0.15s ease-out;
    }
    .marker-bin-wrap:hover .marker-bin-inner { transform: scale(1.25); }
    .bin-empty { background: #94a3b8; }
    .bin-medium { background: #f59e0b; }
    .bin-full { background: #ea580c; }
    .bin-collected { background: #10b981 !important; }

    .marker-incident-inner {
      width: 34px; height: 34px; background: #f59e0b; border: 3px solid #ffffff;
      border-radius: 8px; box-shadow: 0 4px 12px rgba(245, 158, 11, 0.5);
      display: flex; align-items: center; justify-content: center; color: #ffffff;
      font-size: 15px; animation: bounce-incident 1.5s infinite;
    }
    @keyframes bounce-incident { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-6px); } }

    .marker-truck-inner {
      width: 38px; height: 38px; background: #0f172a; border: 3px solid #ffffff;
      border-radius: 50%; box-shadow: 0 4px 14px rgba(0,0,0,0.4);
      display: flex; align-items: center; justify-content: center; color: #ffffff;
      font-size: 16px;
    }
    .marker-truck-wrap { z-index: 100; }

    /* Stop number badges on route */
    .stop-badge-inner {
      width: 18px; height: 18px; background: rgba(15, 23, 42, 0.9);
      border: 1.5px solid #ffffff; border-radius: 50%; color: #ffffff;
      font-size: 9px; font-weight: 700; display: flex; align-items: center; justify-content: center;
    }

    /* Modal Dialog for Human Decision */
    .modal-overlay {
      position: fixed; top: 0; left: 0; width: 100%; height: 100%;
      background: rgba(15, 23, 42, 0.65); backdrop-filter: blur(4px);
      z-index: 1000; display: flex; align-items: center; justify-content: center;
      opacity: 0; pointer-events: none; transition: all 0.25s ease;
    }
    .modal-overlay.open { opacity: 1; pointer-events: auto; }
    .modal-card {
      background: #ffffff; border-radius: 16px; width: 520px; max-width: 90%;
      box-shadow: 0 20px 50px rgba(0,0,0,0.25); overflow: hidden;
      transform: translateY(20px); transition: transform 0.25s ease;
    }
    .modal-overlay.open .modal-card { transform: translateY(0); }
    .modal-header {
      background: linear-gradient(135deg, #ef4444 0%, #b91c1c 100%);
      color: #ffffff; padding: 18px 24px; display: flex; align-items: center; gap: 12px;
    }
    .modal-header h3 { font-size: 16px; font-weight: 700; }
    .modal-body { padding: 20px 24px; display: flex; flex-direction: column; gap: 16px; }
    .modal-incident-desc {
      background: #fef2f2; border: 1px solid #fecaca; border-radius: 8px;
      padding: 12px; font-size: 13.5px; color: #991b1b; line-height: 1.5;
    }
    .modal-options { display: flex; flex-direction: column; gap: 10px; }
    .btn-human-option {
      background: #f8fafc; border: 1.5px solid #cbd5e1; border-radius: 10px;
      padding: 12px 16px; text-align: left; font-size: 13.5px; font-weight: 600;
      color: #1e293b; cursor: pointer; transition: all 0.2s; display: flex; align-items: center; gap: 10px;
    }
    /* AI Auto-Resolution Toast */
    .ai-toast {
      position: fixed; bottom: 32px; left: 50%; transform: translateX(-50%) translateY(120px);
      background: #ffffff; border: 1.5px solid #10b981; border-radius: 12px;
      padding: 12px 18px; display: flex; align-items: center; gap: 12px;
      box-shadow: 0 12px 36px rgba(16, 185, 129, 0.25), 0 4px 12px rgba(0,0,0,0.08);
      z-index: 1000; opacity: 0; pointer-events: none;
      transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
      max-width: 650px;
    }
    .ai-toast.open {
      transform: translateX(-50%) translateY(0);
      opacity: 1; pointer-events: auto;
    }
    .ai-toast-icon {
      width: 40px; height: 40px; border-radius: 10px; background: linear-gradient(135deg, #10b981, #059669);
      color: #ffffff; display: flex; align-items: center; justify-content: center; font-size: 18px; flex-shrink: 0;
    }
    .ai-toast-title { font-size: 12px; font-weight: 700; color: #065f46; text-transform: uppercase; letter-spacing: 0.5px; }
    .ai-toast-msg { font-size: 13px; color: #1e293b; line-height: 1.4; margin-top: 2px; }
    .ai-toast-close {
      background: transparent; border: none; font-size: 16px; color: #94a3b8; cursor: pointer; padding: 4px; border-radius: 6px;
    }
    .ai-toast-close:hover { color: #0f172a; background: #f1f5f9; }
  </style>
</head>
<body>

  <!-- Fullscreen Map Canvas -->
  <div id="map"></div>

  <!-- Top Floating Controls -->
  <div class="control-panel">
    <div class="brand">
      <i class="fa-solid fa-recycle"></i>
      <span>Smart Waste AI</span>
    </div>

    <!-- Placement Modes -->
    <div class="mode-group">
      <button class="btn-mode active" id="btn-mode-view" onclick="setMode('view')">
        <i class="fa-solid fa-hand"></i> Xem
      </button>
      <button class="btn-mode" id="btn-mode-bin" onclick="setMode('bin')">
        <i class="fa-solid fa-trash-can"></i> +Thùng Rác
      </button>
      <button class="btn-mode" id="btn-mode-depot" onclick="setMode('depot')">
        <i class="fa-solid fa-warehouse"></i> +Bãi Rác
      </button>
      <button class="btn-mode" id="btn-mode-incident" onclick="setMode('incident')">
        <i class="fa-solid fa-triangle-exclamation"></i> +Sự Cố
      </button>
    </div>

    <!-- Quick Preset -->
    <button class="btn-action btn-secondary" onclick="loadPresetData()">
      <i class="fa-solid fa-wand-magic-sparkles"></i> Mẫu Q.1 (12 thùng)
    </button>

    <!-- Solve Route -->
    <button class="btn-action btn-primary" id="btn-solve" onclick="solveRoutes()">
      <i class="fa-solid fa-route"></i> Tối Ưu Tuyến Đường
    </button>

    <!-- Simulation -->
    <button class="btn-action btn-sim" id="btn-sim" onclick="toggleSimulation()">
      <i class="fa-solid fa-play"></i> Mô Phỏng Thu Gom
    </button>

    <!-- Reset -->
    <button class="btn-action btn-secondary" onclick="resetAll()">
      <i class="fa-solid fa-rotate-right"></i> Làm mới
    </button>

    <!-- Live Stats -->
    <div class="stats-bar">
      <div class="stat-badge">
        <i class="fa-solid fa-trash"></i> <span id="stat-bins">0 thùng</span>
      </div>
      <div class="stat-badge">
        <i class="fa-solid fa-truck"></i> <span id="stat-trucks">2 xe</span>
      </div>
      <div class="stat-badge">
        <i class="fa-solid fa-road"></i> <span id="stat-dist">0 km</span>
      </div>
    </div>

    <!-- Toggle Drawer Button -->
    <button class="btn-drawer-toggle" onclick="toggleDrawer()">
      <i class="fa-solid fa-list-check"></i> Nhật ký AI & Đội xe
    </button>
  </div>

  <!-- Style Switcher (Traccar OpenFreeMap Vector Styles) -->
  <div class="style-picker">
    <button class="style-btn active" onclick="switchMapStyle('liberty', this)">
      <i class="fa-solid fa-city"></i> Liberty
    </button>
    <button class="style-btn" onclick="switchMapStyle('bright', this)">
      <i class="fa-solid fa-sun"></i> Bright
    </button>
    <button class="style-btn" onclick="switchMapStyle('positron', this)">
      <i class="fa-regular fa-map"></i> Positron
    </button>
    <button class="style-btn" onclick="switchMapStyle('dark', this)">
      <i class="fa-solid fa-moon"></i> Dark
    </button>
    <button class="style-btn" onclick="switchMapStyle('satellite', this)">
      <i class="fa-solid fa-satellite"></i> Vệ tinh
    </button>
  </div>

  <!-- Side Drawer (Live Timeline & Fleet Status) -->
  <div class="drawer" id="side-drawer">
    <div class="drawer-header">
      <span>🚚 Tình Trạng Đội Xe & Xử Lý Sự Cố</span>
      <button class="btn-mode" onclick="toggleDrawer()" style="padding: 2px 6px;"><i class="fa-solid fa-xmark"></i></button>
    </div>
    <div class="drawer-body">
      <div id="fleet-container" style="display: flex; flex-direction: column; gap: 8px;">
        <!-- Truck Cards Generated Here -->
      </div>
      <div style="font-weight: 700; font-size: 13px; color: #475569; margin-top: 8px;">
        <i class="fa-solid fa-clock-rotate-left"></i> Nhật ký hoạt động & AI:
      </div>
      <div id="timeline-container" style="display: flex; flex-direction: column; gap: 8px; max-height: 260px; overflow-y: auto;">
        <div class="timeline-item">
          <span>🕒 Hệ thống sẵn sàng. Nhấn 'Tối Ưu Tuyến Đường' hoặc chọn điểm trên bản đồ.</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Human-in-the-Loop Modal Dialog -->
  <div class="modal-overlay" id="human-modal">
    <div class="modal-card">
      <div class="modal-header">
        <i class="fa-solid fa-triangle-exclamation" style="font-size: 22px;"></i>
        <div>
          <h3 id="modal-title">AI CẦN TRỢ GIÚP TỪ CON NGƯỜI</h3>
          <p style="font-size: 12px; opacity: 0.9;">Sự cố vượt quá khả năng tự quyết của hệ thống</p>
        </div>
      </div>
      <div class="modal-body">
        <div class="modal-incident-desc" id="modal-desc">
          <!-- Incident description inserted here -->
        </div>
        <p style="font-size: 13px; font-weight: 600; color: #475569;">Vui lòng chọn chỉ đạo giải quyết để xe tiếp tục hoạt động:</p>
        <div class="modal-options" id="modal-options">
          <!-- Selectable choices generated dynamically -->
        </div>
      </div>
    </div>
  </div>

  <!-- AI Toast Notification -->
  <div id="ai-toast" class="ai-toast">
    <div class="ai-toast-icon"><i class="fa-solid fa-robot"></i></div>
    <div class="ai-toast-content">
      <div class="ai-toast-title"><i class="fa-solid fa-sparkles"></i> AI Tự Động Xử Lý Sự Cố</div>
      <div id="ai-toast-msg" class="ai-toast-msg"></div>
    </div>
    <button class="ai-toast-close" onclick="dismissAiToast()"><i class="fa-solid fa-xmark"></i></button>
  </div>

  <script>
    // Map Styles (Same as Traccar)
    const STYLES = {
      liberty: 'https://tiles.openfreemap.org/styles/liberty',
      bright: 'https://tiles.openfreemap.org/styles/bright',
      positron: 'https://tiles.openfreemap.org/styles/positron',
      dark: 'https://tiles.openfreemap.org/styles/dark',
      satellite: {
        version: 8,
        sources: {
          'esri': {
            type: 'raster',
            tiles: ['https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}'],
            tileSize: 256,
            attribution: 'Esri World Imagery'
          }
        },
        layers: [{ id: 'satellite-layer', type: 'raster', source: 'esri' }]
      }
    };

    const ROUTE_COLORS = ['#10b981', '#3b82f6', '#f59e0b', '#8b5cf6', '#ec4899'];

    // Map initialization
    const map = new maplibregl.Map({
      container: 'map',
      style: STYLES.liberty,
      center: [106.7015, 10.7765],
      zoom: 14,
      attributionControl: true
    });
    map.addControl(new maplibregl.NavigationControl({ visualizePitch: true }), 'top-right');
    map.addControl(new maplibregl.FullscreenControl(), 'top-right');

    // App State
    let currentMode = 'view';
    let depot = { id: 0, name: "Trạm tập kết rác Bến Nghé", lat: 10.7745, lon: 106.7042 };
    let bins = [];
    let incidents = [];
    let vehicles = [
      { id: 1, name: "Xe rác số 1", capacity: 300, currentLoad: 0, color: '#10b981', status: "Sẵn sàng" },
      { id: 2, name: "Xe rác số 2", capacity: 300, currentLoad: 0, color: '#3b82f6', status: "Sẵn sàng" }
    ];
    let computedRoutes = [];
    let markers = [];
    let truckMarkers = [];
    let stopBadges = [];

    // Simulation State
    let isSimulating = false;
    let simInterval = null;
    let truckSimStates = [];

    // Mode Switcher
    function setMode(mode) {
      currentMode = mode;
      document.querySelectorAll('.btn-mode').forEach(b => b.className = 'btn-mode');
      const activeBtn = document.getElementById(`btn-mode-${mode}`);
      if (activeBtn) activeBtn.classList.add('active', `active-${mode}`);
    }

    // Switch Basemap Style
    function switchMapStyle(styleKey, btn) {
      document.querySelectorAll('.style-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      map.setStyle(STYLES[styleKey]);
      map.once('style.load', () => {
        renderRoutesOnMap();
      });
    }

    function toggleDrawer() {
      document.getElementById('side-drawer').classList.toggle('closed');
    }

    function logTimeline(msg, type = 'default') {
      const container = document.getElementById('timeline-container');
      const now = new Date();
      const timeStr = now.toTimeString().split(' ')[0];
      const div = document.createElement('div');
      div.className = `timeline-item timeline-${type}`;
      div.innerHTML = `<span><b>[${timeStr}]</b> ${msg}</span>`;
      container.prepend(div);
    }

    // Map Click Handler for placing elements
    map.on('click', (e) => {
      const { lng, lat } = e.lngLat;

      if (currentMode === 'bin') {
        const newId = bins.length > 0 ? Math.max(...bins.map(b => b.id)) + 1 : 1;
        const fillLevel = Math.floor(Math.random() * 50) + 50; // 50 - 100%
        const demand = Math.round(fillLevel * 0.5);
        bins.push({
          id: newId,
          name: `Thùng #${newId}`,
          lat: lat, lon: lng,
          fill_level: fillLevel,
          demand: demand,
          collected: false
        });
        logTimeline(`📍 Đã thêm Thùng rác #${newId} (${fillLevel}% đầy, ${demand}kg)`, 'collected');
        updateAll();
      } else if (currentMode === 'depot') {
        depot = { id: 0, name: "Bãi tập kết rác mới", lat: lat, lon: lng };
        logTimeline(`🏢 Đã đổi vị trí Bãi rác trung tâm`, 'default');
        updateAll();
      } else if (currentMode === 'incident') {
        const newId = incidents.length + 1;
        // Alternate between road_blocked (AI resolves) and truck_breakdown (Ask human)
        const type = newId % 2 === 1 ? 'road_blocked' : 'truck_breakdown';
        const name = type === 'road_blocked' ? '🚧 Đường bị phong tỏa' : '🛑 Xe gặp sự cố hỏng hóc';
        incidents.push({
          id: newId,
          type: type,
          name: name,
          lat: lat, lon: lng,
          can_ai_resolve: type === 'road_blocked',
          triggered: false
        });
        logTimeline(`⚠️ Đã đặt mốc sự cố mới: ${name}`, 'incident');
        updateAll();
      }
    });

    // Load Preset Data (District 1 TP.HCM)
    async function loadPresetData() {
      try {
        const resp = await fetch('/api/waste/preset');
        const data = await resp.json();
        depot = data.depot;
        bins = data.bins;
        incidents = data.incidents;
        vehicles = data.vehicles.map(v => ({ ...v, currentLoad: 0, status: "Sẵn sàng" }));
        logTimeline(`🎲 Đã nạp thành công bộ dữ liệu mẫu Q.1 TP.HCM (12 thùng rác, 2 xe rác, 2 mốc sự cố)`, 'ai');
        updateAll();
        solveRoutes(); // Auto solve
      } catch (err) {
        console.error('Error loading preset:', err);
      }
    }

    // Solve Waste VRP Routes
    async function solveRoutes() {
      if (!depot || bins.length === 0) {
        alert("Vui lòng đặt bãi rác và ít nhất 1 thùng rác!");
        return;
      }
      const btn = document.getElementById('btn-solve');
      btn.innerHTML = '<i class="fa-solid fa-circle-notch fa-spin"></i> Đang tối ưu...';

      try {
        const resp = await fetch('/api/waste/solve', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            depot: depot,
            bins: bins,
            vehicles: vehicles
          })
        });
        const res = await resp.json();
        if (res.success) {
          computedRoutes = res.routes;
          logTimeline(`🤖 [Thuật toán]: Tối ưu hoàn tất! Sử dụng ${res.trucks_used} xe, tổng quãng đường ${res.total_distance_km} km`, 'ai');
          document.getElementById('stat-dist').textContent = `${res.total_distance_km} km`;
          await fetchRoadGeometries();
          renderRoutesOnMap();
          updateFleetCards();
        }
      } catch (err) {
        console.error('Solve error:', err);
      } finally {
        btn.innerHTML = '<i class="fa-solid fa-route"></i> Tối Ưu Tuyến Đường';
      }
    }

    // Fetch Turn-by-Turn Road Polylines from OSRM
    async function fetchRoadGeometries() {
      for (const route of computedRoutes) {
        try {
          const coordsStr = route.coordinates.map(c => `${c[0].toFixed(5)},${c[1].toFixed(5)}`).join(';');
          const osrmUrl = `https://router.project-osrm.org/route/v1/driving/${coordsStr}?overview=full&geometries=geojson`;
          const resp = await fetch(osrmUrl);
          const osrmData = await resp.json();
          if (osrmData.code === 'Ok' && osrmData.routes.length > 0) {
            route.streetGeometry = osrmData.routes[0].geometry.coordinates;
          } else {
            route.streetGeometry = route.coordinates;
          }
        } catch (e) {
          route.streetGeometry = route.coordinates;
        }
      }
    }

    // Render Routes on Map
    function renderRoutesOnMap() {
      if (map.getSource('waste-routes-source')) {
        map.removeLayer('waste-routes-casing');
        map.removeLayer('waste-routes-line');
        map.removeSource('waste-routes-source');
      }
      stopBadges.forEach(b => b.remove());
      stopBadges = [];

      if (!computedRoutes || computedRoutes.length === 0) return;

      const features = [];
      computedRoutes.forEach((r, idx) => {
        const color = ROUTE_COLORS[idx % ROUTE_COLORS.length];
        const lineCoords = r.streetGeometry || r.coordinates;

        features.push({
          type: 'Feature',
          properties: { color: color, truckId: r.truck_id },
          geometry: { type: 'LineString', coordinates: lineCoords }
        });

        // Add stop badges
        r.stops.slice(1, -1).forEach((stop, sIdx) => {
          const wrap = document.createElement('div');
          wrap.className = 'stop-badge-wrap';
          const inner = document.createElement('div');
          inner.className = 'stop-badge-inner';
          inner.style.backgroundColor = color;
          inner.textContent = sIdx + 1;
          wrap.appendChild(inner);

          const badge = new maplibregl.Marker({ element: wrap })
            .setLngLat([stop.lon, stop.lat])
            .addTo(map);
          stopBadges.push(badge);
        });
      });

      map.addSource('waste-routes-source', {
        type: 'geojson',
        data: { type: 'FeatureCollection', features: features }
      });

      map.addLayer({
        id: 'waste-routes-casing',
        type: 'line',
        source: 'waste-routes-source',
        layout: { 'line-join': 'round', 'line-cap': 'round' },
        paint: { 'line-color': '#ffffff', 'line-width': 7, 'line-opacity': 0.85 }
      });

      map.addLayer({
        id: 'waste-routes-line',
        type: 'line',
        source: 'waste-routes-source',
        layout: { 'line-join': 'round', 'line-cap': 'round' },
        paint: { 'line-color': ['get', 'color'], 'line-width': 4.5, 'line-opacity': 0.95 }
      });
    }

    // Render Markers (Depot, Bins, Incidents)
    function renderMarkers() {
      markers.forEach(m => m.remove());
      markers = [];

      const bounds = new maplibregl.LngLatBounds();

      // 1. Depot
      if (depot) {
        bounds.extend([depot.lon, depot.lat]);
        const dWrap = document.createElement('div');
        dWrap.className = 'marker-depot-wrap';
        const dInner = document.createElement('div');
        dInner.className = 'marker-depot-inner';
        dInner.innerHTML = '<i class="fa-solid fa-warehouse"></i>';
        dWrap.appendChild(dInner);

        const dPopup = new maplibregl.Popup({ offset: 15 }).setHTML(`
          <div style="font-weight:700; color:#dc2626; margin-bottom:4px;"><i class="fa-solid fa-warehouse"></i> ${depot.name}</div>
          <div style="font-size:12px; color:#475569;">Trạm tập kết rác trung tâm & xuất phát xe</div>
        `);
        markers.push(new maplibregl.Marker({ element: dWrap }).setLngLat([depot.lon, depot.lat]).setPopup(dPopup).addTo(map));
      }

      // 2. Bins
      bins.forEach(b => {
        bounds.extend([b.lon, b.lat]);
        const wrap = document.createElement('div');
        wrap.className = 'marker-bin-wrap';
        const inner = document.createElement('div');
        const fillClass = b.collected ? 'bin-collected' : (b.fill_level >= 85 ? 'bin-full' : (b.fill_level >= 60 ? 'bin-medium' : 'bin-empty'));
        inner.className = `marker-bin-inner ${fillClass}`;
        inner.innerHTML = b.collected ? '<i class="fa-solid fa-check"></i>' : b.id;
        wrap.appendChild(inner);
        b.markerInner = inner;

        const popup = new maplibregl.Popup({ offset: 15 }).setHTML(`
          <div style="font-weight:700; color:#0f172a; margin-bottom:4px;"><i class="fa-solid fa-trash-can"></i> Thùng rác #${b.id}</div>
          <div style="font-size:12px; color:#475569; display:flex; justify-content:space-between;"><span>Độ đầy:</span><b>${b.fill_level}%</b></div>
          <div style="font-size:12px; color:#475569; display:flex; justify-content:space-between;"><span>Lượng rác:</span><b>${b.demand} kg</b></div>
          <div style="font-size:12px; color:#475569; display:flex; justify-content:space-between;"><span>Trạng thái:</span><b style="color:${b.collected ? '#10b981' : '#f59e0b'};">${b.collected ? 'Đã thu gom' : 'Chờ xe đến'}</b></div>
        `);
        markers.push(new maplibregl.Marker({ element: wrap }).setLngLat([b.lon, b.lat]).setPopup(popup).addTo(map));
      });

      // 3. Incidents
      incidents.forEach(inc => {
        bounds.extend([inc.lon, inc.lat]);
        const wrap = document.createElement('div');
        wrap.className = 'marker-incident-wrap';
        const inner = document.createElement('div');
        inner.className = 'marker-incident-inner';
        inner.innerHTML = inc.type === 'road_blocked' ? '<i class="fa-solid fa-ban"></i>' : '<i class="fa-solid fa-wrench"></i>';
        wrap.appendChild(inner);

        const popup = new maplibregl.Popup({ offset: 15 }).setHTML(`
          <div style="font-weight:700; color:#d97706; margin-bottom:4px;">${inc.name}</div>
          <div style="font-size:12px; color:#475569;">${inc.can_ai_resolve ? '🤖 AI có thể tự động né và đổi lộ trình' : '⚠️ AI không tự quyết được (Hỏi người điều phối)'}</div>
        `);
        markers.push(new maplibregl.Marker({ element: wrap }).setLngLat([inc.lon, inc.lat]).setPopup(popup).addTo(map));
      });

      if (bins.length > 0 && !isSimulating) {
        map.fitBounds(bounds, { padding: 80, maxZoom: 15, duration: 800 });
      }
    }

    function updateFleetCards() {
      const container = document.getElementById('fleet-container');
      container.innerHTML = '';
      vehicles.forEach(v => {
        const pct = Math.min(Math.round((v.currentLoad / v.capacity) * 100), 100);
        const card = document.createElement('div');
        card.className = 'truck-card';
        card.innerHTML = `
          <div class="truck-card-header">
            <span style="color:${v.color};"><i class="fa-solid fa-truck"></i> ${v.name}</span>
            <span style="font-weight:600; color:#64748b;">${v.currentLoad} / ${v.capacity} kg</span>
          </div>
          <div class="progress-bar">
            <div class="progress-fill" style="width:${pct}%; background:${v.color};"></div>
          </div>
          <div style="font-size:11.5px; color:#64748b; margin-top:4px;">Trạng thái: <b>${v.status}</b></div>
        `;
        container.appendChild(card);
      });
    }

    function updateAll() {
      document.getElementById('stat-bins').textContent = `${bins.length} thùng`;
      document.getElementById('stat-trucks').textContent = `${vehicles.length} xe`;
      renderMarkers();
      updateFleetCards();
    }

    function resetAll() {
      stopSimulation();
      bins = [];
      incidents = [];
      computedRoutes = [];
      vehicles.forEach(v => { v.currentLoad = 0; v.status = "Sẵn sàng"; });
      updateAll();
      renderRoutesOnMap();
      logTimeline("🔄 Đã làm mới toàn bộ bản đồ", "default");
    }

    // ==========================================
    // ==========================================
    // SIMULATION & AI INCIDENT RESOLUTION ENGINE
    // ==========================================
    function toggleSimulation() {
      if (isSimulating) {
        pauseSimulation();
      } else {
        const canResume = truckSimStates && truckSimStates.some(ts => ts.active && ts.currStep < ts.totalSteps - 1);
        if (canResume) {
          resumeSimulation();
        } else {
          startSimulation();
        }
      }
    }

    function resumeSimulation() {
      if (isSimulating) return;
      isSimulating = true;
      document.getElementById('btn-sim').innerHTML = '<i class="fa-solid fa-pause"></i> Tạm Dừng';
      document.getElementById('btn-sim').classList.add('simulating');
      logTimeline("▶️ Tiếp tục ca làm việc của đội xe...", "default");
      if (simInterval) clearInterval(simInterval);
      simInterval = setInterval(simulationStep, 100);
    }

    function pauseSimulation() {
      isSimulating = false;
      if (simInterval) clearInterval(simInterval);
      document.getElementById('btn-sim').innerHTML = '<i class="fa-solid fa-play"></i> Tiếp Tục';
      document.getElementById('btn-sim').classList.remove('simulating');
    }

    function stopSimulation() {
      pauseSimulation();
      document.getElementById('btn-sim').innerHTML = '<i class="fa-solid fa-play"></i> Mô Phỏng Thu Gom';
    }

    function startSimulation() {
      if (!computedRoutes || computedRoutes.length === 0) {
        alert("Vui lòng tối ưu tuyến đường trước khi chạy mô phỏng!");
        return;
      }

      // Reset bin markers for fresh shift
      bins.forEach(b => {
        b.collected = false;
        if (b.markerInner) {
          const fillClass = (b.fill_level >= 85 ? 'bin-full' : (b.fill_level >= 60 ? 'bin-medium' : 'bin-empty'));
          b.markerInner.className = `marker-bin-inner ${fillClass}`;
          b.markerInner.innerHTML = b.id;
        }
      });
      vehicles.forEach(v => {
        v.currentLoad = 0;
        v.status = "Đang di chuyển thu gom";
      });
      incidents.forEach(inc => { inc.triggered = false; });

      // Initialize truck markers on map
      truckMarkers.forEach(tm => tm.remove());
      truckMarkers = [];
      truckSimStates = computedRoutes.map((r, i) => {
        const coords = r.streetGeometry || r.coordinates;
        const color = ROUTE_COLORS[i % ROUTE_COLORS.length];

        const tWrap = document.createElement('div');
        tWrap.className = 'marker-truck-wrap';
        const tInner = document.createElement('div');
        tInner.className = 'marker-truck-inner';
        tInner.style.backgroundColor = color;
        tInner.innerHTML = '<i class="fa-solid fa-truck"></i>';
        tWrap.appendChild(tInner);

        const marker = new maplibregl.Marker({ element: tWrap })
          .setLngLat(coords[0])
          .addTo(map);

        truckMarkers.push(marker);

        return {
          truckId: r.truck_id,
          coords: [...coords],
          currStep: 0,
          totalSteps: coords.length,
          vehicleRef: vehicles[i] || vehicles[0],
          stops: r.stops,
          active: true
        };
      });

      isSimulating = true;
      document.getElementById('btn-sim').innerHTML = '<i class="fa-solid fa-pause"></i> Tạm Dừng';
      document.getElementById('btn-sim').classList.add('simulating');
      logTimeline("🚀 Bắt đầu ca mô phỏng thu gom rác thực tế...", "default");

      if (simInterval) clearInterval(simInterval);
      simInterval = setInterval(simulationStep, 100);
      updateFleetCards();
    }

    function simulationStep() {
      let anyActive = false;

      truckSimStates.forEach(ts => {
        if (!ts.active) return;
        anyActive = true;

        if (ts.currStep < ts.totalSteps - 1) {
          ts.currStep++;
          const currentPos = ts.coords[ts.currStep];
          truckMarkers[ts.truckId - 1].setLngLat(currentPos);
          ts.vehicleRef.status = "Đang di chuyển thu gom";

          // Check proximity to bins
          bins.forEach(b => {
            if (!b.collected) {
              const d = Math.hypot(currentPos[0] - b.lon, currentPos[1] - b.lat);
              if (d < 0.0004) { // within ~40 meters
                b.collected = true;
                if (b.markerInner) {
                  b.markerInner.className = 'marker-bin-inner bin-collected';
                  b.markerInner.innerHTML = '<i class="fa-solid fa-check"></i>';
                }
                ts.vehicleRef.currentLoad += b.demand;
                logTimeline(`✅ [${ts.vehicleRef.name}] Đã thu gom xong Thùng #${b.id} (+${b.demand}kg)`, 'collected');
                updateFleetCards();
              }
            }
          });

          // Check proximity to incidents
          incidents.forEach(inc => {
            if (!inc.triggered) {
              const d = Math.hypot(currentPos[0] - inc.lon, currentPos[1] - inc.lat);
              if (d < 0.0006) { // within ~60 meters
                inc.triggered = true;
                handleEncounteredIncident(inc, ts);
              }
            }
          });
        } else {
          ts.active = false;
          ts.vehicleRef.status = "Đã hoàn thành lộ trình";
          logTimeline(`🎉 [${ts.vehicleRef.name}] Đã về đến Bãi tập kết rác! Hoàn thành ca làm việc.`, 'collected');
          updateFleetCards();
        }
      });

      if (!anyActive) {
        stopSimulation();
      }
    }

    // Dynamic AI Detour: Reroute around blocked incident from current position
    async function rerouteTruckDetour(truckState, incident) {
      const currentPos = truckState.coords[truckState.currStep]; // [lon, lat]

      // Identify uncollected remaining stops for this truck
      const uncollectedStops = truckState.stops.filter(s => {
        if (s.type === 'depot') return false;
        const bin = bins.find(b => b.id === s.id);
        return bin && !bin.collected;
      });

      // Calculate a detour waypoint perpendicular to obstacle vector (~180m offset)
      const dLon = currentPos[0] - incident.lon;
      const dLat = currentPos[1] - incident.lat;
      const detourLon = incident.lon + (Math.abs(dLat) >= Math.abs(dLon) ? 0.0022 : -0.0022);
      const detourLat = incident.lat + (Math.abs(dLon) >= Math.abs(dLat) ? 0.0018 : -0.0018);

      const waypoints = [currentPos, [detourLon, detourLat]];
      uncollectedStops.forEach(s => waypoints.push([s.lon, s.lat]));
      waypoints.push([depot.lon, depot.lat]);

      try {
        const coordsStr = waypoints.map(c => `${c[0].toFixed(5)},${c[1].toFixed(5)}`).join(';');
        const osrmUrl = `https://router.project-osrm.org/route/v1/driving/${coordsStr}?overview=full&geometries=geojson`;
        const resp = await fetch(osrmUrl);
        const data = await resp.json();

        let newRoadCoords = waypoints;
        if (data.code === 'Ok' && data.routes.length > 0) {
          newRoadCoords = data.routes[0].geometry.coordinates;
        }

        // Splice truck coords: keep past path (0 .. currStep), append new detour path!
        const pastCoords = truckState.coords.slice(0, truckState.currStep + 1);
        truckState.coords = pastCoords.concat(newRoadCoords.slice(1));
        truckState.totalSteps = truckState.coords.length;

        // Update route geometry on map in real time
        const routeObj = computedRoutes.find(r => r.truck_id === truckState.truckId);
        if (routeObj) {
          routeObj.streetGeometry = truckState.coords;
          renderRoutesOnMap();
        }

        logTimeline(`🔀 [AI Tái Định Tuyến]: Đã tính lộ trình đường vòng mới né điểm nghẽn! Xe chạy tiếp từ vị trí hiện tại (${newRoadCoords.length} điểm tọa độ).`, 'ai');
      } catch (err) {
        console.warn('Detour OSRM error:', err);
      }
    }

    // Dynamic AI Stop Reassignment: Assign broken truck's stops to other active truck
    async function reassignStopsToOtherTruck(brokenTruckState) {
      brokenTruckState.active = false;
      brokenTruckState.vehicleRef.status = "🛑 Hỏng động cơ (Dừng tại chỗ)";

      // Find the other active truck
      const otherTruck = truckSimStates.find(ts => ts.truckId !== brokenTruckState.truckId && ts.active);
      if (!otherTruck) {
        logTimeline(`⚠️ Không còn xe rác nào khác đang hoạt động để nhận bàn giao.`, 'incident');
        return;
      }

      // Collect uncollected bins from both trucks
      const uncollectedBroken = bins.filter(b => !b.collected && brokenTruckState.stops.some(s => s.id === b.id));
      const uncollectedOther = bins.filter(b => !b.collected && otherTruck.stops.some(s => s.id === b.id));
      const allTargetBins = [...uncollectedOther, ...uncollectedBroken];

      const otherCurrentPos = otherTruck.coords[otherTruck.currStep]; // [lon, lat]

      // Simple Nearest Neighbor ordering from other truck's current pos
      const orderedBins = [];
      let cur = otherCurrentPos;
      const pool = [...allTargetBins];
      while (pool.length > 0) {
        let bestIdx = 0;
        let bestDist = Infinity;
        for (let i = 0; i < pool.length; i++) {
          const d = Math.hypot(cur[0] - pool[i].lon, cur[1] - pool[i].lat);
          if (d < bestDist) {
            bestDist = d;
            bestIdx = i;
          }
        }
        const nextBin = pool.splice(bestIdx, 1)[0];
        orderedBins.push(nextBin);
        cur = [nextBin.lon, nextBin.lat];
      }

      // Build waypoints: otherCurrentPos -> orderedBins -> depot
      const waypoints = [otherCurrentPos];
      orderedBins.forEach(b => waypoints.push([b.lon, b.lat]));
      waypoints.push([depot.lon, depot.lat]);

      try {
        const coordsStr = waypoints.map(c => `${c[0].toFixed(5)},${c[1].toFixed(5)}`).join(';');
        const osrmUrl = `https://router.project-osrm.org/route/v1/driving/${coordsStr}?overview=full&geometries=geojson`;
        const resp = await fetch(osrmUrl);
        const data = await resp.json();

        let newRoadCoords = waypoints;
        if (data.code === 'Ok' && data.routes.length > 0) {
          newRoadCoords = data.routes[0].geometry.coordinates;
        }

        // Splice other truck coordinates from current position
        const pastCoords = otherTruck.coords.slice(0, otherTruck.currStep + 1);
        otherTruck.coords = pastCoords.concat(newRoadCoords.slice(1));
        otherTruck.totalSteps = otherTruck.coords.length;
        otherTruck.stops = [{ type: 'truck_pos', lat: otherCurrentPos[1], lon: otherCurrentPos[0] }]
          .concat(orderedBins)
          .concat([depot]);

        // Truncate broken truck route on map to where it stopped
        const brokenRouteObj = computedRoutes.find(r => r.truck_id === brokenTruckState.truckId);
        if (brokenRouteObj) {
          brokenRouteObj.streetGeometry = brokenTruckState.coords.slice(0, brokenTruckState.currStep + 1);
        }

        // Expand other truck route on map
        const otherRouteObj = computedRoutes.find(r => r.truck_id === otherTruck.truckId);
        if (otherRouteObj) {
          otherRouteObj.streetGeometry = otherTruck.coords;
        }

        renderRoutesOnMap();

        logTimeline(`📋 [Điều Phối]: Đã tích hợp ${uncollectedBroken.length} thùng của xe hỏng sang ${otherTruck.vehicleRef.name}. Lộ trình mới đã sẵn sàng!`, 'ai');
      } catch (err) {
        console.warn('Reassign OSRM error:', err);
      }
    }

    // Handle Encountered Incident (AI or Human Decision)
    async function handleEncounteredIncident(incident, truckState) {
      pauseSimulation(); // Freeze trucks in their exact current position

      logTimeline(`⚠️ CẢNH BÁO: ${truckState.vehicleRef.name} gặp sự cố: ${incident.name}!`, 'incident');

      try {
        const resp = await fetch('/api/waste/resolve-incident', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            incident: incident,
            truck_state: {
              truck_id: truckState.truckId,
              current_load: truckState.vehicleRef.currentLoad,
              capacity: truckState.vehicleRef.capacity
            },
            all_trucks: vehicles
          })
        });

        const resolution = await resp.json();

        if (resolution.resolved_by_ai) {
          // AI RESOLVED AUTOMATICALLY -> DYNAMIC DETOUR!
          logTimeline(resolution.log, 'ai');
          showAiToast(resolution.log);

          // Calculate dynamic detour around obstacle from current position
          await rerouteTruckDetour(truckState, incident);

          // Briefly pause 2.5s for user observation, then resume from current position!
          setTimeout(() => {
            resumeSimulation();
          }, 2500);
        } else {
          // AI CANNOT RESOLVE -> ASK HUMAN!
          logTimeline(`❓ [AI Xin Chỉ Đạo]: Sự cố cần người điều phối quyết định: ${resolution.message}`, 'human');
          showHumanModal(resolution, truckState);
        }
      } catch (err) {
        console.error('Incident resolution error:', err);
      }
    }

    let toastTimer = null;
    function showAiToast(msg) {
      const toast = document.getElementById('ai-toast');
      document.getElementById('ai-toast-msg').textContent = msg;
      toast.classList.add('open');
      if (toastTimer) clearTimeout(toastTimer);
      toastTimer = setTimeout(() => {
        toast.classList.remove('open');
      }, 5000);
    }

    function dismissAiToast() {
      document.getElementById('ai-toast').classList.remove('open');
    }

    // Show Human Decision Modal Dialog
    function showHumanModal(resolution, truckState) {
      document.getElementById('modal-title').textContent = resolution.title || "AI CẦN TRỢ GIÚP TỪ CON NGƯỜI";
      document.getElementById('modal-desc').innerHTML = `<b>Mô tả sự cố:</b> ${resolution.message}`;

      const optionsContainer = document.getElementById('modal-options');
      optionsContainer.innerHTML = '';

      resolution.options.forEach((opt, idx) => {
        const btn = document.createElement('button');
        btn.className = 'btn-human-option';
        btn.innerHTML = `<i class="fa-solid fa-circle-arrow-right" style="color:#2563eb;"></i> <span><b>Phương án ${idx + 1}:</b> ${opt.label}</span>`;
        btn.onclick = () => {
          selectHumanOption(opt, truckState);
        };
        optionsContainer.appendChild(btn);
      });

      document.getElementById('human-modal').classList.add('open');
    }

    async function selectHumanOption(option, truckState) {
      document.getElementById('human-modal').classList.remove('open');
      logTimeline(`👤 [Người Điều Phối Quyết Định]: Đã chọn: "${option.label}"`, 'human');

      if (option.action === 'dispatch_rescue') {
        truckState.vehicleRef.name = `${truckState.vehicleRef.name} (Xe dự phòng #3)`;
        truckState.vehicleRef.status = "Xe dự phòng tiếp quản";
        logTimeline(`🚚 Xe dự phòng #3 đã xuất phát và tiếp quản lộ trình từ vị trí xe hỏng!`, 'ai');
        updateFleetCards();
        resumeSimulation(); // Resume from exact current location!
      } else if (option.action === 'split_to_active_trucks') {
        await reassignStopsToOtherTruck(truckState);
        updateFleetCards();
        resumeSimulation(); // Resume other truck from current location!
      } else {
        truckState.active = false;
        truckState.vehicleRef.status = "🛑 Tạm ngừng ca làm";
        logTimeline(`🛑 Đã kết thúc ca sớm theo chỉ đạo con người. Các xe khác tiếp tục chạy.`, 'human');
        updateFleetCards();
        resumeSimulation(); // Resume other truck!
      }
    }

    // Initial Load
    loadPresetData();
  </script>
</body>
</html>
