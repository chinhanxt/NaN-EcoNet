# ==============================================================================
# 🌿 NaN-EcoNet: Monorepo Centralized Environment Configuration
# Copy this file to .env and configure your secret credentials before running.
# ==============================================================================

# ==============================================================================
# 1. SHARED & CORE INFRASTRUCTURE
# ==============================================================================
# Environment Mode: development | staging | production
NODE_ENV=development
ENVIRONMENT=development
TZ=Asia/Ho_Chi_Minh

# Global Database Connection (PostgreSQL / SQLite)
DATABASE_URL=postgresql://postgres:postgres_secure_pass@localhost:5432/nan_econet

# Global Redis Queue URL (Background jobs, telemetry streaming, broker cache)
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379

# ==============================================================================
# 2. ECOPASS ENTERPRISE SUITE
# ==============================================================================
# Web & API Ports
ECOPASS_PORT=3000
ECOPASS_API_PORT=5001
MCP_SERVER_PORT=5001

# Public Domain / FQDN
DOMAIN=localhost
SECURE_COOKIES=False
EXPIRY_THRESHOLD_DAYS=90

# Social & Messaging Integrations
FACEBOOK_API_KEY=your_facebook_graph_api_key_here
FACEBOOK_APP_SECRET=your_facebook_app_secret_here
ZALO_OA_SECRET=your_zalo_official_account_secret_here
ZALO_APP_ID=your_zalo_app_id_here
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_NOTIFICATION_CHAT_ID=-1001234567890

# ==============================================================================
# 3. SMART COLLECTION & 3D-PACO ROUTING ENGINE
# ==============================================================================
# Engine Microservice Ports
COLLECTION_ENGINE_PORT=5000
COLLECTION_DASHBOARD_PORT=8501

# OSRM (Open Source Routing Machine) Host
OSRM_HOST=http://localhost:5003
OSRM_PORT=5003

# Fleet Optimization Parameters
NUM_FLEET_VEHICLES=8
MAX_CAPACITY_KG=5000
SOLVER_DEFAULT_ALGORITHM=paco
SOLVER_TIMEOUT_SECONDS=300

# Route Cache & Spatial Parameters
ROUTE_CACHE_FILE=./map_ui/route_cache.json
HCM_DEPOT_LAT=10.7769
HCM_DEPOT_LNG=106.7009

# ==============================================================================
# 4. CITIZEN BULKY APP & IOT DISPATCHER
# ==============================================================================
# Citizen Web & Traccar Ports
CITIZEN_PORTAL_PORT=3001
CITIZEN_API_PORT=5002

# AI Vision & Multimodal Waste Classification
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Bulky Waste Pricing & Dispatching Security
PRICING_BASE_RATE=250000
DISPATCHER_SECRET=super_secret_dispatcher_token_production_nan_econet

# Traccar GPS & IoT Device Permissions
TRACCAR_ADMIN_USER=admin@xathongminh.gov.vn
TRACCAR_ADMIN_PASS=AdminPassword123!
TRACCAR_API_URL=http://localhost:5002/api
