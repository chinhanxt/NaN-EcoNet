# Add these values to the local environment used by backend and orchestrator.
# Keep AGY credentials in the isolated AGY profile; do not put tokens here.
SOURCE_VIDEO_ENABLED=true
SOURCE_VIDEO_JOB_DIRECTORY=/absolute/private/job-directory
SOURCE_VIDEO_MAX_ACTIVE=1
SOURCE_VIDEO_MAX_QUEUED=10
SOURCE_VIDEO_ORG_MAX_QUEUED=2
OPENSHORTS_PYTHON=/absolute/NaN-Team/packages/openshorts-engine/bin/docker-python
OPENSHORTS_WHISPER_MODEL_DIRECTORY=/absolute/preprovisioned/phowhisper-small-ct2-int8
WHISPER_LANGUAGE=vi
OPENSHORTS_YOLO_MODEL_PATH=/absolute/preprovisioned/yolov8n.pt
OPENSHORTS_DOCKER_IMAGE=sha256:replace-with-local-immutable-image-id
OPENSHORTS_DOCKER_CPUS=1
OPENSHORTS_DOCKER_MEMORY=2g
OPENSHORTS_MAX_INPUT_BYTES=1073741824
OPENSHORTS_MAX_WORK_BYTES=5368709120
OPENSHORTS_MAX_DURATION_SECONDS=21600
AGY_MCP_PROVIDER_URL=http://127.0.0.1:8899

OPENSHORTS_THREADS=1

# Optional: private encryption key shared by backend/orchestrator webhook workers.
# If omitted, JWT_SECRET is used. Keep the key stable for pending deliveries.
# SOURCE_VIDEO_WEBHOOK_ENCRYPTION_KEY=
