apps/citizen-bulky-app/mobile/android/.gradle/

# iOS platform builds
apps/citizen-bulky-app/mobile/ios/Pods/
apps/citizen-bulky-app/mobile/ios/.symlinks/
apps/citizen-bulky-app/mobile/ios/Flutter/Flutter.framework
apps/citizen-bulky-app/mobile/ios/Flutter/Flutter.podspec
*.xcworkspace
*.xcuserdata

# Executable / Compiled mobile artifacts
*.apk
*.aab
*.ipa
*.app

