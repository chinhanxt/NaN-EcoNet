# ==============================================================================
# 🌿 NaN-EcoNet: Monorepo Root .gitignore
# Multilingual Coverage: Python, TypeScript/Node.js, Dart/Flutter, Docker & OS
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment Variables & Credentials (Security First)
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.env
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.jks
*.keystore
id_rsa*
secrets/

# ------------------------------------------------------------------------------
# 2. Node.js & TypeScript / Frontend Frameworks
# ------------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
.bun/

# Build outputs
dist/
build/
out/
.next/
.nuxt/
.turbo/
.cache/

# Linter & Typecheck caches
.eslintcache
.stylelintcache
*.tsbuildinfo

# ------------------------------------------------------------------------------
# 3. Python Ecosystem (Backend, AI & Solver Engines)
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Packaging & Distribution
*.egg-info/
.installed.cfg
*.egg
eggs/
.eggs/
develop-eggs/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/

# Virtual Environments
venv/
.venv/
env/
.env/
ENV/
env.bak/
venv.bak/

# Testing & Type Checking
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/
.tox/
.nox/

# Jupyter Notebook Checkpoints
.ipynb_checkpoints/

# ------------------------------------------------------------------------------
