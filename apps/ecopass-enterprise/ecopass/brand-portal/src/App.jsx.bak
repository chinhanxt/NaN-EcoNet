const MONTH_POINTS = [
  { m: "Th1", val: "+8.20%", count: "9,820", x: 25, y: 160 },
  { m: "Th2", val: "+9.45%", count: "10,450", x: 75, y: 105 },
  { m: "Th3", val: "+11.10%", count: "11,200", x: 130, y: 120 },
