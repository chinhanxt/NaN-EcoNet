const WEEKLY_VOUCHER_DATA = [
  { day: "CN", fullDay: "Chủ Nhật", count: 1420, topY: 105, x: 65 },
  { day: "T2", fullDay: "Thứ Hai", count: 2150, topY: 65, x: 142 },
  { day: "T3", fullDay: "Thứ Ba", count: 2587, topY: 42, x: 220 },
